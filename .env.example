# Shared environment defaults for local development.
APP_ENV=development
APP_NAME=Weather API
LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:5173"]
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=20
LOCATION_CACHE_TTL_SECONDS=86400
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_CACHE_STALE_TTL_SECONDS=7200
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
WEATHER_PROVIDER_READ_TIMEOUT_SECONDS=10
WEATHER_PROVIDER_WRITE_TIMEOUT_SECONDS=5
WEATHER_PROVIDER_POOL_TIMEOUT_SECONDS=3
WEATHER_PROVIDER_MAX_CONNECTIONS=20
WEATHER_PROVIDER_MAX_KEEPALIVE_CONNECTIONS=10
WEATHER_PROVIDER_MAX_ATTEMPTS=3
WEATHER_PROVIDER_RETRY_BASE_DELAY_SECONDS=0.2
WEATHER_PROVIDER_RETRY_MAX_DELAY_SECONDS=2
WEATHER_PROVIDER_RETRY_JITTER_RATIO=0.25
WEATHER_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
WEATHER_PROVIDER_CIRCUIT_RECOVERY_SECONDS=30
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
VITE_API_BASE_URL=http://localhost:8000

